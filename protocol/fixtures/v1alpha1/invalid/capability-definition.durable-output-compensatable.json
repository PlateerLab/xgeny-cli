{
  "apiVersion": "xgeny.io/v1alpha1",
  "kind": "CapabilityDefinition",
  "metadata": {
    "id": "example/unsupported-compensatable-output",
    "contractVersion": "1.0.0",
    "displayName": "Invalid compensatable durable output"
  },
  "spec": {
    "summary": "This fixture must fail because compensatable durable output has no runtime profile.",
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "effect": {
      "class": "compensatable",
      "resourceSelectors": [],
      "criticalActions": []
    },
    "requiredCapabilities": [],
    "execution": {
      "styles": ["sync"],
      "cancellable": false,
      "idempotencyKeySupported": false,
      "durableToolOutput": true,
      "defaultTimeoutMs": 1000,
      "maxTimeoutMs": 1000
    },
    "verification": [
      {"strategy": "output_schema", "required": true}
    ]
  }
}
