{
  "apiVersion": "xgeny.io/v1alpha1",
  "kind": "CapabilityDefinition",
  "metadata": {
    "id": "xgeny.fs/apply-patch",
    "contractVersion": "1.0.0",
    "displayName": "Apply exact text edits atomically",
    "labels": {"xgeny.io/pack": "core-os"}
  },
  "spec": {
    "summary": "Apply non-overlapping exact contextual edits to one existing UTF-8 text file atomically.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["path", "expectedDigest", "edits"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "expectedDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["oldText", "newText"],
            "properties": {
              "oldText": {"type": "string", "minLength": 1, "maxLength": 65536},
              "newText": {"type": "string", "maxLength": 65536}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["path", "digest", "byteSize", "changed", "editCount"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "byteSize": {"type": "integer", "minimum": 0, "maximum": 65536},
        "changed": {"type": "boolean"},
        "editCount": {"type": "integer", "minimum": 1, "maximum": 32}
      },
      "additionalProperties": false
    },
    "effect": {
      "class": "idempotent",
      "resourceSelectors": [
        {"scope": "filesystem.write", "argumentPointer": "/path"}
      ],
      "criticalActions": []
    },
    "requiredCapabilities": [],
    "execution": {
      "styles": ["sync"],
      "cancellable": false,
      "idempotencyKeySupported": true,
      "durableToolOutput": true,
      "defaultTimeoutMs": 30000,
      "maxTimeoutMs": 120000
    },
    "verification": [
      {"strategy": "output_schema", "required": true},
      {"strategy": "postcondition", "required": true, "description": "The confined target still contains the exact patched digest when Core verifies it."}
    ],
    "discovery": {
      "keywords": ["file", "patch", "edit", "atomic", "text"],
      "examples": ["Replace one exact function body previously observed with read-text without rewriting the whole file."]
    }
  }
}
